{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uselesstoday",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "uselesstoday.com", "custom_domain": true },
    { "pattern": "www.uselesstoday.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
