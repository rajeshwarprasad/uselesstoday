---
// Chess: Human vs Computer — self-contained game, sandboxed in an <iframe>.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import GameGuide from "../components/GameGuide.astro";

const howTo = [
  "Click one of your white pieces to select it. Every legal destination square lights up.",
  "Click a highlighted square to move, or drag the piece there instead.",
  "The computer replies automatically, usually within a second or two.",
  "Use Undo to take back the last move, or Reset to start a fresh game.",
  "The game ends at checkmate, stalemate, or resignation-by-closing-the-tab.",
];

const tips = [
  "Develop knights and bishops before pushing pawns; the AI punishes slow openings.",
  "Castle early. A king stuck in the middle is a target for the rest of the game.",
  "Undo is there for experiments: try a line, see the reply, then take it back.",
  "Trade pieces when you are ahead in material and the board opens up.",
  "Watch for forks and pins. The computer sets them more often than it blunders.",
];

const faqs = [
  {
    q: "Do I need an account to play?",
    a: "No. There is no sign-up, no login and no download. The board loads and you start playing.",
  },
  {
    q: "Can I play against another person?",
    a: "Not on this page. You play white against the computer; local multiplayer is not supported here.",
  },
  {
    q: "Which colour do I play?",
    a: "You are always white and move first. The computer takes black.",
  },
  {
    q: "Is it full chess with all the rules?",
    a: "Yes — castling, en passant and pawn promotion are all implemented, along with check and checkmate detection.",
  },
  {
    q: "Does it work on a phone?",
    a: "Yes. Tap to select a piece and tap again to move. The board scales to the screen, and fullscreen gives you more room.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: "Chess — Human vs Computer",
  url: "https://uselesstoday.com/chess/",
  applicationCategory: "GameApplication",
  operatingSystem: "Any (web browser)",
  genre: "Board game",
  playMode: "SinglePlayer",
  description:
    "Play chess against the computer right in your browser. Drag the pieces, take on the AI, and see if you can win. Free, no install, no sign-up.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Layout
  title="Chess vs Computer — Free Online Game | Useless Today"
  description="Play chess against the computer free in your browser. Move by clicking or dragging, undo any mistake, and chase checkmate."
  path="/chess/"
  schema={schema}
  keywords={[
    "play chess online free",
    "chess vs computer online",
    "free browser chess game",
    "chess game no download",
    "play chess against ai",
    "online chess multiplayer",
    "chess board game browser",
  ]}
>
  <Nav />
  <main id="main-content">
    <section class="mx-auto max-w-[1200px] px-4 pt-16 pb-6 sm:px-6">
      <p class="font-mono text-[12px] uppercase tracking-wide text-mute">
        Games · gloriously pointless
      </p>
      <h1
        class="mt-3 text-[36px] font-semibold leading-[1.05] tracking-[-0.03em] text-ink sm:text-[48px]"
      >
        Chess
      </h1>
      <p class="mt-5 max-w-[680px] text-[18px] leading-7 text-body">
        The oldest time-killer there is, versus a computer that never gets
        tired of you. Drag your pieces, hunt the king, and see how far you get
        before the AI has other ideas.
      </p>
    </section>

    <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6">
      <div
        class="ludo-frame mx-auto w-full max-w-[560px] overflow-hidden rounded-xl border border-hairline shadow-float"
      >
        <iframe
          src="/games/chess.html"
          title="Chess — human vs computer"
          loading="lazy"
          allowfullscreen
          class="block w-full border-0"
        ></iframe>
      </div>

      <p class="mx-auto mt-4 max-w-[560px] text-center text-[13px] text-mute">
        Not fitting on your screen?
        <a
          href="/games/chess.html"
          class="text-link underline decoration-link/40 underline-offset-2 transition-colors hover:decoration-link"
          >Open it fullscreen →</a
        >
      </p>
    </section>

    <GameGuide
      intro="Chess against a computer is either humbling or quietly addictive, depending on how the first ten moves go. This build is deliberately plain: a board, the full rules, timers for both sides, and an opponent that will punish loose pieces without taking twenty minutes over every move."
      howTo={howTo}
      tips={tips}
      faqs={faqs}
    />
  </main>
  <Footer />
</Layout>

<style>
  .ludo-frame iframe {
    height: clamp(640px, 100vw + 240px, 880px);
    background: #1e1e2a;
  }
</style>
