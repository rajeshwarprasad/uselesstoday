---
// Bubble Shooter Premium — self-contained portrait game, sandboxed in an iframe.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import GameGuide from "../components/GameGuide.astro";

const howTo = [
  "Press Play to deal a fresh board. The launcher loads a colour for you automatically.",
  "Move the mouse, or drag a finger, to aim. A dotted line shows the path, including bounces off the side walls.",
  "Click or tap to fire. The bubble sticks to the first one it touches.",
  "Group three or more of the same colour to pop them. Anything left hanging with no connection to the top drops away for bonus points.",
  "Keep the stack off the bottom row. If the bubbles reach you, the round is over and your score is final.",
];

const tips = [
  "Bank shots off the side walls to reach gaps you cannot hit straight on.",
  "Aim for the bubbles holding up the biggest cluster; one good pop can drop a dozen at once.",
  "Clear the lowest rows first when the stack creeps close — it buys you breathing room.",
  "Play in portrait on a phone; the board is built for a tall screen.",
  "Use the fullscreen link if the frame feels cramped.",
];

const faqs = [
  {
    q: "Is Bubble Shooter free to play?",
    a: "Yes. It runs entirely in the browser with no install, no account and no payment. The whole game is a single page.",
  },
  {
    q: "Does it work on phones and tablets?",
    a: "Yes. Aim with your finger and tap to fire; the board scales to fit the screen.",
  },
  {
    q: "Is there a time limit?",
    a: "No. Nothing counts down. The only pressure is the stack of bubbles creeping towards the bottom row.",
  },
  {
    q: "Can I play it fullscreen?",
    a: "Yes. Use the fullscreen link under the game, or open /games/bubble.html directly in a tab.",
  },
  {
    q: "Does it save my high score?",
    a: "No. Scores reset when you reload or start again, which keeps the game free of accounts and tracking.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: "Bubble Shooter",
  url: "https://uselesstoday.com/bubble/",
  applicationCategory: "GameApplication",
  operatingSystem: "Any (web browser)",
  genre: "Arcade / Puzzle",
  playMode: "SinglePlayer",
  description:
    "Play Bubble Shooter free in your browser. Aim, match three or more, and clear the board. The classic, endlessly satisfying time-waster. No install.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Layout
  title="Bubble Shooter — Free Online Game | Useless Today"
  description="Play Bubble Shooter free in your browser. Aim, match three of a colour, and pop the board clear — no download, no sign-up, no timer."
  path="/bubble/"
  schema={schema}
  keywords={[
    "play classic bubble shooter game",
    "bubble shooter online free",
    "classic bubble shooter",
    "bubble shooter game online",
    "free bubble pop game",
    "play bubble shooter free",
    "bubble shooter arcade game",
    "match three bubble game",
  ]}
>
  <Nav />
  <main id="main-content">
    <section class="mx-auto max-w-[1200px] px-4 pt-16 pb-6 sm:px-6">
      <p class="font-mono text-[12px] uppercase tracking-wide text-mute">
        Games · gloriously pointless
      </p>
      <h1
        class="mt-3 text-[36px] font-semibold leading-[1.05] tracking-[-0.03em] text-ink sm:text-[48px]"
      >
        Bubble Shooter
      </h1>
      <p class="mt-5 max-w-[680px] text-[18px] leading-7 text-body">
        Aim, fire, and match three of a colour to pop them off the board. One of
        those perfectly pointless little games that quietly eats an afternoon.
        Don't say we didn't warn you.
      </p>
    </section>

    <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6">
      <div
        class="ludo-frame mx-auto w-full max-w-[480px] overflow-hidden rounded-xl border border-hairline shadow-float"
      >
        <iframe
          src="/games/bubble.html"
          title="Bubble Shooter"
          loading="lazy"
          allowfullscreen
          class="block w-full border-0"
        ></iframe>
      </div>

      <p class="mx-auto mt-4 max-w-[480px] text-center text-[13px] text-mute">
        Not fitting on your screen?
        <a
          href="/games/bubble.html"
          class="text-link underline decoration-link/40 underline-offset-2 transition-colors hover:decoration-link"
          >Open it fullscreen →</a
        >
      </p>
    </section>

    <GameGuide
      intro="Bubble Shooter is the arcade classic in its purest form: a wall of coloured bubbles creeps downward, a launcher sits at the bottom, and the only thing between order and chaos is your aim. There is no timer, no story and no reason for any of it, which is exactly why it works as a five-minute reset."
      howTo={howTo}
      tips={tips}
      faqs={faqs}
    />
  </main>
  <Footer />
</Layout>

<style>
  /* Portrait 9:16 play area — give it a tall, narrow frame. */
  .ludo-frame iframe {
    height: clamp(680px, 160vw, 880px);
    background: #0f2027;
  }
</style>
