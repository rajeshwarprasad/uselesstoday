---
// Our Valentine Journey — a self-contained interactive sweet-nothing. Sandboxed
// in an <iframe> so its full-screen body styling never touches the site shell.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import GameGuide from "../components/GameGuide.astro";

const howTo = [
  "Type a name on the cover, or leave it blank to get a generic “For Someone Special” card.",
  "Click Cut Ribbon to open the card.",
  "Click anywhere on a page to turn it. Each page holds a short message and a date.",
  "At the end, answer the proposal to unlock the (very scientific) love calculator.",
  "Use the copy-link button to share a personalised version; the name travels inside the URL.",
];

const tips = [
  "Add the name before you copy the link, otherwise the card arrives anonymous.",
  "The card works best on a phone held in portrait, like a real folded card.",
  "Turn pages slowly; each one is a single message rather than a wall of text.",
  "Send it on the day itself instead of a week early, if you can manage the timing.",
  "It is a link, not an attachment, so it will not get stuck in spam filters.",
];

const faqs = [
  {
    q: "Is the Valentine card free?",
    a: "Yes. There is no payment, no account and no app to install. It is a single page you can open or share.",
  },
  {
    q: "Can I put someone's name on it?",
    a: "Yes. Type the name on the cover, then copy the link. The name is stored in the URL, so the card opens personalised for whoever you send it to.",
  },
  {
    q: "Is this a real card or a game?",
    a: "Neither, really. It is a short interactive story: a cover, a ribbon to cut, a page per day, a proposal and a love calculator at the end.",
  },
  {
    q: "Do I need to install anything?",
    a: "No. It runs in any modern browser on a phone, tablet or desktop.",
  },
  {
    q: "Can I send it by text or email?",
    a: "Yes. Copy the link and paste it wherever you like; nothing else needs to travel with it.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Our Valentine Journey",
  url: "https://uselesstoday.com/valentine/",
  description:
    "A tiny, lovingly pointless Valentine experience — hearts, sweet nothings, and a little interactive journey to make someone smile.",
};
---

<Layout
  title="Valentine — Interactive Love Letter | Useless Today"
  description="A tiny interactive Valentine you can personalise and send as a link. Cut the ribbon, turn the pages, and make someone smile."
  path="/valentine/"
  schema={schema}
  keywords={[
    "romantic valentine greetings for husband",
    "last minute valentine ecards",
    "valentine e-cards online",
    "free valentine ecards",
    "romantic valentine greetings",
    "valentine card for husband",
    "valentine greetings online",
    "send valentine ecard free",
    "interactive valentine card",
  ]}
>
  <Nav />
  <main id="main-content">
    <section class="mx-auto max-w-[1200px] px-4 pt-16 pb-6 sm:px-6">
      <p class="font-mono text-[12px] uppercase tracking-wide text-mute">
        Silly · gloriously pointless
      </p>
      <h1
        class="mt-3 text-[36px] font-semibold leading-[1.05] tracking-[-0.03em] text-ink sm:text-[48px]"
      >
        Valentine
      </h1>
      <p class="mt-5 max-w-[680px] text-[18px] leading-7 text-body">
        A tiny interactive love letter — floating hearts and a sweet little
        journey that does exactly one charming, useless thing. Open it, tap
        along, and send the link to someone who deserves a smile.
      </p>
    </section>

    <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6">
      <div
        class="ludo-frame mx-auto w-full max-w-[600px] overflow-hidden rounded-xl border border-hairline shadow-float"
      >
        <iframe
          src="/games/valentine.html"
          title="Our Valentine Journey — interactive experience"
          loading="lazy"
          allowfullscreen
          class="block w-full border-0"
        ></iframe>
      </div>

      <p class="mx-auto mt-4 max-w-[600px] text-center text-[13px] text-mute">
        Not fitting on your screen?
        <a
          href="/games/valentine.html"
          class="text-link underline decoration-link/40 underline-offset-2 transition-colors hover:decoration-link"
          >Open it fullscreen →</a
        >
      </p>
    </section>

    <GameGuide
      intro="This is not really a game. It is a small, hand-built Valentine that opens like a paper card: a cover, a ribbon to cut, a page for each day, a proposal, and a slightly ridiculous love calculator at the end. It takes two minutes, costs nothing, and exists purely to be sent to somebody."
      howTo={howTo}
      tips={tips}
      faqs={faqs}
    />
  </main>
  <Footer />
</Layout>

<style>
  .ludo-frame iframe {
    height: clamp(640px, 92vh, 800px);
    background: #1a1a2e;
  }
</style>
