---
// /sites/[slug]/ — individual useless-site page with unique editorial copy,
// structured data and related links.
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { LINKS, CATEGORIES, slugify } from "../../data/links";
import { SITE_COPY } from "../../data/site-copy";

export function getStaticPaths() {
  return LINKS.map((l) => ({ params: { slug: slugify(l.title) } }));
}

const { slug } = Astro.params;

const site = LINKS.find((l) => slugify(l.title) === slug);

if (!site) {
  return Astro.redirect("/sites/");
}

const copy = SITE_COPY[slugify(site.title)];

// Pick 4 related sites from the same category (excluding this one), then fill
// from other categories if needed.
const sameCat = LINKS.filter(
  (l) => l.category === site.category && l.title !== site.title,
);
const otherCat = LINKS.filter((l) => l.category !== site.category);
const related = [...sameCat, ...otherCat].slice(0, 4);

const catLabel =
  CATEGORIES.find((c) => c.id === site.category)?.label ?? site.category;

const checked = new Intl.DateTimeFormat("en-GB", {
  month: "long",
  year: "numeric",
}).format(new Date());

const canonical = `https://uselesstoday.com/sites/${slugify(site.title)}/`;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${site.title} — useless website`,
  url: canonical,
  description: `${site.title}: ${site.blurb}`,
  isPartOf: {
    "@type": "WebSite",
    name: "Useless Today",
    url: "https://uselesstoday.com/",
  },
  about: {
    "@type": "WebSite",
    name: site.title,
    url: site.url,
    description: site.blurb,
  },
};
---

<Layout
  title={`${site.title} — Useless Website | Useless Today`}
  description={`${site.blurb} ${site.title} is one of ${LINKS.length} hand-picked useless websites on Useless Today.`}
  path={`/sites/${slugify(site.title)}/`}
  schema={schema}
  keywords={[
    site.title.toLowerCase(),
    "useless website",
    "useless site",
    "pointless website",
    `${site.category} useless sites`,
    "take me to a useless website",
  ]}
>
  <Nav />
  <main id="main-content">
    <article class="mx-auto max-w-[760px] px-4 py-20 sm:px-6">
      <p class="font-mono text-[12px] uppercase tracking-wide text-mute">
        {catLabel} · useless site · checked {checked}
      </p>
      <h1
        class="mt-3 text-[36px] font-semibold leading-[1.05] tracking-[-0.03em] text-ink sm:text-[48px]"
      >
        {site.emoji} {site.title}
      </h1>
      <p class="mt-5 max-w-[680px] text-[18px] leading-7 text-body">
        {site.blurb}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={site.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-12 items-center gap-2 rounded-full bg-ink px-6 text-[16px] font-medium text-on-primary shadow-[var(--shadow-card)] transition-transform hover:scale-[1.03] active:scale-95"
        >
          Visit {site.title}
          <span aria-hidden="true">↗</span>
        </a>
        <a
          href="/sites/"
          class="inline-flex h-12 items-center rounded-full border border-hairline bg-canvas px-6 text-[16px] font-medium text-ink transition-colors hover:bg-canvas-soft-2"
        >
          Browse the wall
        </a>
      </div>

      {
        copy ? (
          <>
            <section class="mt-14">
              <h2 class="text-[24px] font-semibold tracking-[-0.03em] text-ink sm:text-[28px]">
                What is {site.title}?
              </h2>
              <p class="mt-4 text-[16px] leading-7 text-body">{copy.detail}</p>
            </section>

            <section class="mt-12">
              <h2 class="text-[24px] font-semibold tracking-[-0.03em] text-ink sm:text-[28px]">
                How to use it
              </h2>
              <ul class="mt-4 space-y-2 text-[16px] leading-7 text-body">
                {copy.tips.map((tip) => (
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="mt-[2px] text-mute">
                      —
                    </span>
                    <span>{tip}</span>
                  </li>
                ))}
              </ul>
            </section>

            <section class="mt-12">
              <h2 class="text-[24px] font-semibold tracking-[-0.03em] text-ink sm:text-[28px]">
                Why it's on the wall
              </h2>
              <p class="mt-4 text-[16px] leading-7 text-body">{copy.note}</p>
            </section>
          </>
        ) : null
      }

      <section class="mt-12 rounded-xl border border-hairline bg-canvas-soft p-5">
        <p class="text-[15px] leading-7 text-body">
          Every link on <a href="/">Useless Today</a> is chosen by a human and
          rechecked regularly. Spot a dead end at {site.title}?{" "}
          <a href="/contact/">Tell us</a> and we'll replace it with something
          equally pointless.
        </p>
      </section>

      <section class="mt-14">
        <h2 class="text-[24px] font-semibold tracking-[-0.03em] text-ink sm:text-[28px]">
          More useless {catLabel.toLowerCase()} sites
        </h2>
        <ul class="mt-4 space-y-3">
          {
            related.map((r) => (
              <li class="text-[16px] leading-7 text-body">
                <a
                  href={`/sites/${slugify(r.title)}/`}
                  class="font-medium text-ink underline decoration-link/40 underline-offset-2 transition-colors hover:decoration-link"
                >
                  {r.emoji} {r.title}
                </a>{" "}
                — {r.blurb}
              </li>
            ))
          }
        </ul>
      </section>

      <nav class="mt-14" aria-label="Category links">
        <h2 class="text-[24px] font-semibold tracking-[-0.03em] text-ink sm:text-[28px]">
          Browse by category
        </h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            CATEGORIES.map((c) => (
              <li>
                <a
                  href={`/sites/${c.id}/`}
                  class="inline-flex h-9 items-center rounded-full border border-hairline bg-canvas px-4 text-[14px] text-body transition-colors hover:bg-canvas-soft-2 hover:text-ink"
                >
                  {c.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </article>
  </main>
  <Footer />
</Layout>
