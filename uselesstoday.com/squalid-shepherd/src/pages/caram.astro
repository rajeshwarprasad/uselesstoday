---
// Carrom King 3D — self-contained game, sandboxed in an <iframe>.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import GameGuide from "../components/GameGuide.astro";

const howTo = [
  "Press Play. Your striker sits on the near baseline and you shoot first.",
  "Drag the striker left or right along the line to choose your angle of approach.",
  "Pull back away from the striker, like a slingshot. The further you pull, the harder the flick.",
  "Release to shoot. Any white coin that drops into a pocket stays down and scores.",
  "Clear your coins, take the queen for 50 points, and finish with the higher score. Sinking the striker is a foul.",
];

const tips = [
  "Thin cuts along the edge pocket more reliably than head-on blasts.",
  "Try to leave the striker near the middle so your next shot has options.",
  "Break clusters up early; loose coins are easier to pocket than packed ones.",
  "The queen is worth 50 points, but only chase her when you have a clean line.",
  "Gentle drags are more accurate than hard ones on short shots.",
];

const faqs = [
  {
    q: "Is Carrom 3D free to play?",
    a: "Yes. The game runs in the browser with no install, no account and no payment.",
  },
  {
    q: "Do I play against a person or the computer?",
    a: "You play the white coins against a CPU opponent, which takes its turn automatically after yours.",
  },
  {
    q: "How do I aim and shoot?",
    a: "Drag the striker along the baseline to set your angle, pull back away from it to build power, then release to flick.",
  },
  {
    q: "What counts as a foul?",
    a: "Sinking the striker is a foul — the game flashes a warning. Keep the striker on the board and let the coins do the work.",
  },
  {
    q: "Does it work on a phone or tablet?",
    a: "Yes. Touch and drag replaces the mouse for both aiming and pulling back the striker.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: "Carrom 3D",
  url: "https://uselesstoday.com/caram/",
  applicationCategory: "GameApplication",
  operatingSystem: "Any (web browser)",
  genre: "Board game",
  playMode: "SinglePlayer",
  description:
    "Play Carrom 3D free in your browser. Flick the striker, pocket your coins, and sink the queen. The classic board game, no install required.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Layout
  title="Carrom 3D — Free Online Board Game | Useless Today"
  description="Play Carrom 3D free in your browser. Drag the striker, pull back, and flick your coins into the pockets. No download, no sign-up."
  path="/caram/"
  schema={schema}
  keywords={[
    "play carrom board game free",
    "carrom board game online",
    "play carrom online free",
    "carrom 3d game",
    "free carrom game",
    "carrom game online",
    "online carrom board",
    "carrom striker game",
  ]}
>
  <Nav />
  <main id="main-content">
    <section class="mx-auto max-w-[1200px] px-4 pt-16 pb-6 sm:px-6">
      <p class="font-mono text-[12px] uppercase tracking-wide text-mute">
        Games · gloriously pointless
      </p>
      <h1
        class="mt-3 text-[36px] font-semibold leading-[1.05] tracking-[-0.03em] text-ink sm:text-[48px]"
      >
        Carrom
      </h1>
      <p class="mt-5 max-w-[680px] text-[18px] leading-7 text-body">
        Drag back the striker, line up your shot, and flick. Pocket your coins,
        sink the queen, and rediscover why every family gathering ends in a
        carrom argument — now in glorious 3D, right in your browser.
      </p>
    </section>

    <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6">
      <div
        class="ludo-frame mx-auto w-full max-w-[640px] overflow-hidden rounded-xl border border-hairline shadow-float"
      >
        <iframe
          src="/games/caram.html"
          title="Carrom 3D board game"
          loading="lazy"
          allowfullscreen
          class="block w-full border-0"
        ></iframe>
      </div>

      <p class="mx-auto mt-4 max-w-[640px] text-center text-[13px] text-mute">
        Not fitting on your screen?
        <a
          href="/games/caram.html"
          class="text-link underline decoration-link/40 underline-offset-2 transition-colors hover:decoration-link"
          >Open it fullscreen →</a
        >
      </p>
    </section>

    <GameGuide
      intro="Carrom is the tabletop game nobody bothers to explain properly: you flick a striker, coins scatter everywhere, and somebody argues about a foul. This version puts a 3D board in your browser, gives you the white coins, and hands the black ones to a CPU opponent with a suspiciously good line in thin cuts."
      howTo={howTo}
      tips={tips}
      faqs={faqs}
    />
  </main>
  <Footer />
</Layout>

<style>
  .ludo-frame iframe {
    height: clamp(580px, 95vw + 130px, 820px);
    background: #2c3e50;
  }
</style>
